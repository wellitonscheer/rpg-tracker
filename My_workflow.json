        "jsCode": "const base64Image = $input.first().json.candidates[0].content.parts[1].inlineData.data;\n    const decodedImage = Buffer.from(base64Image, 'base64');\n    \n    const items = {\n      image: {\n        data: decodedImage,\n        type: 'image/png', // Or the correct MIME type\n        filename: 'decoded_image.png' // Or a dynamic filename\n      }\n    };\n    \n    return items;"
