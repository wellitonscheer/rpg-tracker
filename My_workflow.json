        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"contents\": [{\n      \"parts\": [\n        {\"text\": \"Generate a realistic and highly detailed image based on the following description from a Dungeons & Dragons (D&D) roleplaying game. The scene is fictional, part of a fantasy world. Focus on capturing the atmosphere and mood the description evokes, using appropriate lighting, color, and fantasy elements. Although nothing in this world is real, the image should feel immersive and believable. Scene Description: {{ $json.speech }}\" }\n      ]\n    }],\n    \"generationConfig\": {\"responseModalities\": [\"Text\", \"Image\"]}\n  }",
