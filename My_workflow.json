    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-preview-image-generation:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env['GOOGLE_GEMINI_API_KEY'] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"contents\": [{\n      \"parts\": [\n        {\"text\": \"Gere uma imagem 16:9 altamente realista e rica em detalhes com base na descrição a seguir. A imagem deve parecer uma fotografia realista. Reproduza fielmente todos os elementos descritos, incluindo arquitetura, personagens, clima, luz, vestimentas, objetos e atmosfera. Use iluminação cinematográfica e estética realista, evitando qualquer estilo de ilustração de jogos ou desenhos. Não pode aparecer texto ou legenda na imagem. Descrição da cena: '{{ $json.speech }}'\" }\n      ]\n    }],\n    \"generationConfig\": {\"responseModalities\": [\"Text\", \"Image\"]}\n  }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        596,
        160
      ],
      "id": "7e843cdb-8e6f-4dc6-9c5b-a0be36c7085a",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const base64Image = $input.first().json.candidates[0].content.parts[1].inlineData.data;\n    const decodedImage = Buffer.from(base64Image, 'base64');\n    \n    items[0].binary = {\n     data: {\n       data: decodedImage\n     }\n    };\n    \n    return items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
